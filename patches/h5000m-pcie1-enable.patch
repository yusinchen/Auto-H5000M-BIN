diff --git a/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts b/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts
--- a/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts
+++ b/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts
@@ -81,3 +81,25 @@
 		};
 	};
 };
+
+/*
+ * M.2 B-key slot (5G modem) is on PCIe port 1.  mt7987a.dtsi uses pin 38
+ * (PCIE_WAKE_N_1) as &pcie0's wifi-reset-gpios, but the stock pcie1_pins
+ * mux group still claims that same pin, so enabling &pcie1 as-is collides
+ * and the controller never probes.  Use a board-local pinmux without
+ * pcie1_wake; PCIe WAKE# is only needed for D3cold remote wakeup.
+ */
+&pio {
+	pcie1_pins_nowake: pcie1-pins-nowake {
+		mux {
+			function = "pcie";
+			groups = "pcie1_pereset", "pcie1_clkreq";
+		};
+	};
+};
+
+&pcie1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie1_pins_nowake>;
+	status = "okay";
+};
