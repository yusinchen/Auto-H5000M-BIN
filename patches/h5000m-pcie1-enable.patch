diff --git a/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts b/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts
--- a/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts
+++ b/target/linux/mediatek/dts/mt7987a-hiveton-h5000m.dts
@@ -81,3 +81,33 @@
 		};
 	};
 };
+
+/*
+ * M.2 B-key slot (5G modem) hangs off PCIe port 1.
+ *
+ * mt7987a.dtsi keeps &pcie1 disabled and uses pin 38 (PCIE_WAKE_N_1) as
+ * &pcie0's wifi-reset-gpios.  The stock pcie1_pins mux group in
+ * mt7987-pinctrl.dtsi still claims "pcie1_wake" (the very same pin), so
+ * simply flipping &pcie1 to "okay" collides and the controller never
+ * probes:
+ *
+ *   pin PCIE_WAKE_N_1 already requested by pinctrl_moore:550
+ *   mtk-pcie-gen3 11290000.pcie: Error applying setting, reverse things back
+ *
+ * Define a board-local pinmux without pcie1_wake rather than editing the
+ * shared SoC pinctrl file.  PCIe WAKE# is only needed for D3cold remote
+ * wakeup, which a modem in this slot never uses.
+ */
+&pio {
+	pcie1_pins_nowake: pcie1-pins-nowake {
+		mux {
+			function = "pcie";
+			groups = "pcie1_pereset", "pcie1_clkreq";
+		};
+	};
+};
+
+&pcie1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie1_pins_nowake>;
+	status = "okay";
+};
